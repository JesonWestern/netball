/*
 * src/app.rc -- NetBall 资源脚本
 * 编译: windres --input src\app.rc --output build\app.res --output-format=coff
 * 说明: 图标路径相对「rc 文件所在目录」(src\)，故为 ..\assets\app.ico
 */

#include <windows.h>
#include "resource.h"

/* 本文件为 UTF-8 无 BOM 编码，必须显式告知 windres 字符串代码页，
 * 否则中文会按 ANSI(CP936) 解析成乱码。 */
#pragma code_page(65001)

/* ------------------------------------------------------------------ 图标 */
IDI_APP ICON "..\\assets\\app.ico"

/* ------------------------------------------------- 应用清单 RT_MANIFEST(24) */
1 24 "app.manifest"

/* -------------------------------------------------------------- 版本信息 */
1 VERSIONINFO
 FILEVERSION     1,4,4,0
 PRODUCTVERSION  1,4,4,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 简体中文 0x0804 / Unicode 1200 */
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "NetBall"
            VALUE "FileDescription",  "NetBall 网速悬浮球"
            VALUE "FileVersion",      "1.4.4.0"
            VALUE "InternalName",     "NetBall"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "NetBall.exe"
            VALUE "ProductName",      "NetBall"
            VALUE "ProductVersion",   "1.4.4.0"
        END
        /* 英文 0x0409 / Unicode 1200 */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NetBall"
            VALUE "FileDescription",  "NetBall network speed floating ball"
            VALUE "FileVersion",      "1.4.4.0"
            VALUE "InternalName",     "NetBall"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "NetBall.exe"
            VALUE "ProductName",      "NetBall"
            VALUE "ProductVersion",   "1.4.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200, 0x0409, 1200
    END
END

/* ---------------------------------------------------------------- 字符串表 */
STRINGTABLE
BEGIN
    IDS_APPNAME "NetBall 网速悬浮球"
    IDS_VERSION "1.4.4"
END
